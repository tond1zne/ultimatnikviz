# Zkopíruj tyto proměnné do Vercel → Project → Settings → Environment Variables.
# Hodnoty pro FIREBASE_* najdeš ve Firebase Console → Project settings →
# General → Your apps → SDK setup and configuration → Config.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Heslo, kterým se přihlašuje role "Admin" v appce (vymysli si vlastní).
ADMIN_PASSWORD=
